# CrewAI language model. Groq free tier goes through LiteLLM as groq/<model id>.
# openai/gpt-oss-120b supports tool use. The key is never stored in source code.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Optional. Leave empty for Groq. Set only for an OpenAI-compatible gateway.
LLM_BASE_URL=

# AnythingLLM Employee Knowledge. The API key stays in this file and is never hard-coded.
ANYTHINGLLM_BASE_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_EMPLOYEE_WORKSPACE_SLUG=estetikai-employee-knowledge
# Danışan paneli bu çalışma alanına sorar. Boşsa estetikai-public-knowledge kullanılır.
ANYTHINGLLM_PUBLIC_WORKSPACE_SLUG=estetikai-public-knowledge

# false calls the live workspace. true uses labeled mock excerpts and does not call AnythingLLM.
MOCK_MODE=false
